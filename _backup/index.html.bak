<title>Porprov 2026 Quick Count - Solo Juara</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'solo-red': '#cc0000',
            'solo-red-dark': '#8b0000',
            'solo-blue': '#0a1930',
            'solo-gold': '#f5a623',
            'solo-gold-light': '#fdf2d5',
            'medal-gold': '#ffd700',
            'medal-silver': '#c0c0c0',
            'medal-bronze': '#cd7f32',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<style data-purpose="custom-styles">
    body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
    .hero-bg {
      background: 
        url('hero-bg.png') center calc(100% - 40px) / contain no-repeat,
        linear-gradient(to right, #960309, #520111, #67030B) center bottom / 100% 50px no-repeat,
        #010F2B;
      position: relative;
      overflow: hidden;
    }

    .hero-content { position: relative; z-index: 2; }
    .shadow-card { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .medal-icon-large { font-size: 3rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
    .podium-1 { background: linear-gradient(to bottom, #fceabb, #f8b500); }
    .podium-2 { background: linear-gradient(to bottom, #e2e2e2, #999999); }
    .podium-3 { background: linear-gradient(to bottom, #f5d0b5, #c87a41); }
  </style>
</head>
<body class="bg-gray-100 flex justify-center">
