</div>

<script>
  function switchPage(pageId, element) {
    // Hide all pages
    const pages = document.querySelectorAll('.page-content');
    pages.forEach(page => {
      page.classList.remove('block');
      page.classList.add('hidden');
    });

    // Show target page
    document.getElementById('page-' + pageId).classList.remove('hidden');
    document.getElementById('page-' + pageId).classList.add('block');

    // Reset all nav icons
    const navItems = document.querySelectorAll('.nav-item');
    navItems.forEach(item => {
      item.classList.remove('text-solo-red');
      item.classList.add('text-gray-500');
      // Reset font weight
      const span = item.querySelector('span');
      span.classList.remove('font-bold');
      span.classList.add('font-medium');
    });

    // Set active nav icon
    element.classList.remove('text-gray-500');
    element.classList.add('text-solo-red');
    const activeSpan = element.querySelector('span');
    activeSpan.classList.remove('font-medium');
    activeSpan.classList.add('font-bold');
    
    // Scroll to top when changing page
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
